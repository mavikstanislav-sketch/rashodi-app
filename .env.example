PORT=3000
SESSION_SECRET=change-me-in-production
NODE_ENV=development

# Оставьте пустыми для локальной разработки — тогда данные хранятся
# в файле data/rashodi.db. Заполните оба значения, чтобы использовать
# облачную БД Turso (нужно для хостинга без постоянного диска).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
