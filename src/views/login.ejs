<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Вход — Расходы</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#4f46e5" />
  <link rel="icon" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
</head>
<body class="auth-page">
  <div class="auth-card">
    <h1>Учёт расходов</h1>
    <p class="auth-subtitle">Войдите, чтобы посмотреть свои траты</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <label>Email
        <input type="email" name="email" required autofocus placeholder="you@example.com" />
      </label>
      <label>Пароль
        <input type="password" name="password" required placeholder="••••••••" />
      </label>
      <button type="submit" class="btn btn-primary btn-block">Войти</button>
    </form>

    <div class="demo-box">
      <strong>Демо-доступ:</strong><br />
      Email: <code>demo@example.com</code><br />
      Пароль: <code>demo1234</code>
    </div>

    <p class="auth-footer">Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
  </div>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    }
  </script>
</body>
</html>
